{
  "rewrites": [
    {
      "source": "/",
      "destination": "/portfolio.html"
    }
  ],
  "redirects": [
    {
      "source": "/card",
      "destination": "/?from=nfc",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}